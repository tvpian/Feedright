# Production environment — copy to .env and fill in real values
# NEVER commit .env to git (it is in .gitignore)

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=nutritrack
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=nutritrack

DATABASE_URL=postgresql://nutritrack:change_me_strong_password@db:5432/nutritrack

# ── Optional integrations ─────────────────────────────────────────────────────
# USDA food database (free key at https://fdc.nal.usda.gov/api-guide.html)
# Falls back to DEMO_KEY (rate-limited) if not set
USDA_API_KEY=

# Ollama AI coach (optional — only needed if you use the AI Coach feature)
# Point to wherever Ollama is running; host.docker.internal works on Mac/Windows
OLLAMA_BASE_URL=http://host.docker.internal:11434
