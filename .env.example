# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./nutritrack.db

# PostgreSQL (comment out SQLite line above and uncomment below):
# DATABASE_URL=postgresql://nutritrack:nutritrack@localhost:5432/nutritrack

# ── Ollama ─────────────────────────────────────────────────────────────────────
# Defaults to http://localhost:11434 if not set
# OLLAMA_BASE_URL=http://localhost:11434

# ── Next.js ────────────────────────────────────────────────────────────────────
# URL of the FastAPI backend (seen from the browser)
NEXT_PUBLIC_API_BASE=http://localhost:8000

# -- USDA FoodData Central ------------------------------------------
# Register at https://fdc.nal.usda.gov/api-key-signup.html
# DEMO_KEY is used if unset (~1000 req/hr per IP)
# USDA_API_KEY=your_key_here
